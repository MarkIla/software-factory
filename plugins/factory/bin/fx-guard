#!/usr/bin/env python3
"""PreToolUse hook entry for the factory plugin. Most tool calls in most sessions are not made by factory
agents, so answer those in a few milliseconds and hand only factory agents' calls to fx's full guard."""
import json
import os
import subprocess
import sys

raw = sys.stdin.read()
if '"agent_type"' not in raw:
    sys.exit(0)
try:
    agent = str(json.loads(raw).get("agent_type") or "")
except ValueError:
    sys.exit(0)
if not (agent.startswith("factory:") or agent.startswith("fx-")):
    sys.exit(0)
fx = os.path.join(os.path.dirname(os.path.abspath(__file__)), "fx")
sys.exit(subprocess.run([sys.executable, fx, "guard", "--hook"], input=raw, text=True).returncode)
