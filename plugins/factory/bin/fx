#!/usr/bin/env python3
"""fx: the deterministic spine of the software factory.

The /factory orchestrator and the agents never change job state themselves.
Every move goes through this script, which refuses illegal ones and talks to
the tracker (Jira or GitHub issues) and the forge (GitLab or GitHub).

Python 3.9+, git 2.38+, standard library only.
"""
from __future__ import annotations

