def _agent_prefix():
    try:
        return json.loads((PLUGIN_DIR / ".claude-plugin" / "plugin.json").read_text())["name"] + ":"
    except (OSError, ValueError, KeyError):
        return "fx-"


AGENT_PREFIX = _agent_prefix()


def role_of(agent_type):
    t = (agent_type or "").strip()
    if not (t.startswith(AGENT_PREFIX) or t.startswith("fx-")):
        return None
    t = t.split(":")[-1]
    t = t[3:] if t.startswith("fx-") else t
    return t if t in ROLES else None
